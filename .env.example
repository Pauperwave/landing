# Used by nuxt-auth-utils
NUXT_SESSION_PASSWORD=
# Used to login and upload images
NUXT_ADMIN_PASSWORD=
# Cloudflare R2 through its S3 API, used in production only (development stores files in .data)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
# https://<account id>.r2.cloudflarestorage.com
S3_ENDPOINT=
